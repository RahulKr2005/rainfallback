# Environment Configuration
APP_NAME=RainfallInundationAI
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Study Area Bounding Box (Provisional Delhi-NCR)
STUDY_AREA_NAME=Delhi-NCR
BBOX_MIN_LAT=28.30
BBOX_MAX_LAT=28.88
BBOX_MIN_LON=76.84
BBOX_MAX_LON=77.45

# Official Data Credentials (Optional / As needed)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
COPERNICUS_CDS_API_KEY=
IMD_DATA_PORTAL_TOKEN=

# Cache and Storage Paths
DATA_DIR=./data
MODELS_DIR=./models
CACHE_TTL_HOURS=6
